{
  "name": "dsh-trace-waterfall",
  "version": "0.1.0",
  "description": "A live, searchable trace waterfall for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "Wang Xin",
  "repository": "github:greatv/dsh-trace-waterfall",
  "homepage": "https://github.com/greatv/dsh-trace-waterfall",
  "engines": { "node": ">=24.9.0" },
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["lib", "locale", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-api-session-controller"]
    }
  },
  "scripts": {
    "link:dsh": "node scripts/link-dsh.mjs",
    "build": "node scripts/build.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
